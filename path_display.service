[Unit]
Description=PATH Train Matrix Display
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 __PATH_MATRIX_DIR__/main.py
WorkingDirectory=__PATH_MATRIX_DIR__
Restart=always
RestartSec=10
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
