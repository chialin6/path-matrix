[Unit]
Description=PATH Train Matrix Display
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/chialin6/path-matrix/main.py --station GRV
WorkingDirectory=/home/chialin6/path-matrix
Restart=always
RestartSec=10
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
